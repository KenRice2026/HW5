# Campus Customs: environment variables. Copy to .env (never commit .env) or set them in
# your shell / Windows user environment. Only ANTHROPIC_API_KEY is required.

# Required: Claude API key used by the five PydanticAI agents (backend/agents).
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: model for every agent (default anthropic:claude-opus-5-5).
# CC_MODEL=anthropic:claude-opus-5-5

# Optional: point the MCP server, backend and audit trail at scratch copies for testing.
# Defaults: data/campus_customs_new.db and output/audit_trail.json.
# The original data/campus_customs.db is always read-only (it is the reset source).
# CC_DB_PATH=data/campus_customs_new.db
# CC_AUDIT_PATH=output/audit_trail.json

# The dashboard's backend URL lives in frontend/.env:
# VITE_API_URL=http://localhost:8000
